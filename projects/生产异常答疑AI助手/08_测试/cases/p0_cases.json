{
  "auth": {
    "admin": {
      "url": "http://127.0.0.1:8000/api/auth/login",
      "body": {
        "username": "admin",
        "password": "admin123"
      },
      "token_path": "access_token"
    },
    "employee": {
      "url": "http://127.0.0.1:8000/api/auth/login",
      "body": {
        "username": "employee",
        "password": "employee123"
      },
      "token_path": "access_token"
    }
  },
  "cases": [
    {
      "id": "P0-001",
      "name": "登录-正确账号返回 token",
      "method": "POST",
      "url": "http://127.0.0.1:8000/api/auth/login",
      "body": {
        "username": "admin",
        "password": "admin123"
      },
      "expect_status": 200,
      "expect_json_contains": [
        "access_token"
      ]
    },
    {
      "id": "P0-002",
      "name": "登录-错误密码被拒绝",
      "method": "POST",
      "url": "http://127.0.0.1:8000/api/auth/login",
      "body": {
        "username": "admin",
        "password": "wrong-pwd"
      },
      "expect_status": 401,
      "expect_json_contains": []
    },
    {
      "id": "P0-003",
      "name": "无 token 访问受保护接口被拒",
      "method": "GET",
      "url": "http://127.0.0.1:8000/api/tickets",
      "headers": {
        "Authorization": ""
      },
      "expect_status": 401,
      "expect_json_contains": []
