# ===== 模型提供方：local（默认，省钱/离线） / api（云端兜底） =====
MODEL_PROVIDER=local

# 本地 Ollama（需先 ollama pull qwen2.5:3b-instruct-q4_K_M）
LOCAL_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL=qwen2.5:3b-instruct-q4_K_M

# 云端（阿里云百炼 OpenAI 兼容，仅 MODEL_PROVIDER=api 时生效）
API_BASE_URL=https://ws-9171bgaaryxlug64.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
API_KEY=
API_MODEL=qwen-plus

# ===== Embedding =====
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
API_EMBEDDING_MODEL=text-embedding-v3

# ===== 存储 =====
CHROMA_DIR=./data/chroma
DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=./data/uploads

# ===== 安全 =====
JWT_SECRET=change-me-in-local-please
JWT_EXPIRE_MINUTES=1440

# ===== 检索/分级参数 =====
RETRIEVE_TOP_K=8
ENSEMBLE_TOP_K=4
SIMILARITY_THRESHOLD=0.35
CONFIDENCE_THRESHOLD=0.6
RERANK_ENABLED=false
