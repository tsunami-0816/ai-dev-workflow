# 复制为 .env 并填写实际值（.env 已在 .gitignore，口令不进仓库/代码）
# MySQL：共用容器 ecom-mysql，宿主机端口 3310
DB_HOST=127.0.0.1
DB_PORT=3310
DB_NAME=ecom_scrape
DB_ROOT_USER=root
DB_ROOT_PASSWORD=change_me
DB_RW_USER=ecom_rw
DB_RW_PASSWORD=change_me
DB_RO_USER=ecom_ro
DB_RO_PASSWORD=change_me
# 1=外部站点走本地 mock_site（5190）；0=真实适配器（需真实 Cookie，失败降级不崩溃）
MOCK_MODE=1
MOCK_SITE_URL=http://127.0.0.1:5190
API_HOST=127.0.0.1
API_PORT=8094
# 降级开关：逗号分隔平台名（如 tmall）；DISABLE_RPA=1 关 RPA 补采
DISABLE_PLATFORMS=
DISABLE_RPA=0
RPA_MAX_BROWSERS=1
DB_RW_POOL=5
DB_RO_POOL=10
