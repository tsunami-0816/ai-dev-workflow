# 后端环境变量模板（与 application.yml 的 ${...} 一一对应）
# 用法：复制为 .env 或由启动脚本注入；真实值只放本机/部署平台，不要提交。
# 8.5 安全扫描 ③：模板已与代码引用对齐（2026-11-21）。

PROJECT_NAME=uniapp-booking
SERVER_PORT=8092

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DB=uniapp_booking
MYSQL_USER=root
MYSQL_PASSWORD=change-me

# Redis（本机 dev 无 AUTH；生产必须设密码并限制监听地址）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# RabbitMQ
MQ_HOST=127.0.0.1
MQ_PORT=5672
MQ_USER=change-me
MQ_PASSWORD=change-me

# JWT / HMAC：生产必须替换为 32 字节以上随机串，禁止使用 dev 默认值
JWT_SECRET=change-me-32-bytes-random
APP_SECRET=change-me-32-bytes-random
