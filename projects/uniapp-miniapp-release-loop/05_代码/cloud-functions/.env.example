# 云函数环境变量模板（T-206）
# 复制为 .env 后由启动脚本注入；或直接在终端 export。**不要提交真实密钥。**

# 云函数本机 http 模式端口（端口分配表已登记 8093）
CF_PORT=8093
CF_HOST=127.0.0.1
# cloud | http（cloud 为微信云开发，http 为本机 8093 降级）
CF_MODE=http
# 后端地址（小程序 http 模式必须能从本机访问）
CF_BACKEND_BASE=http://127.0.0.1:8092
# 单次请求超时（毫秒，T-206 定 3000）
CF_TIMEOUT_MS=3000
# 传输层/5xx 重试次数（T-206 定 1）
CF_RETRY=1
# 请求体上限（字节，网关层 1MB 对齐）
CF_MAX_BODY_BYTES=1048576

# 云函数 → 后端 HMAC 共享密钥（必须与后端 APP_SECRET 完全一致）
# 本地 dev 留空则用 application.yml 的 dev 默认值；上线/验收必须显式设置为 32 位随机串
APP_SECRET=

# 微信登录（getOpenid 用；只在服务端，绝不进前端）
MP_APPID=wx58cd971ff2494b89
MP_APPSECRET=
# getOpenid 本机入口端口
OPENID_PORT=8094
# code2session 地址（默认微信官方；自测时指向本地 mock）
WX_API_BASE=https://api.weixin.qq.com
