            "maxLength": 32,
            "minLength": 0,
            "type": "string"
          },
          "password": {
            "maxLength": 64,
            "minLength": 0,
            "type": "string"
          },
          "openid": {
            "maxLength": 64,
            "minLength": 0,
            "type": "string"
          },
          "nickname": {
            "maxLength": 64,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "LoginResponse": {
