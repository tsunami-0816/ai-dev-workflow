  "components": {
    "schemas": {
      "BookingRequest": {
        "required": [
          "bookDate",
          "contact",
          "packageId",
          "slot"
        ],
        "type": "object",
        "properties": {
          "packageId": {
            "type": "integer",
            "format": "int64"
          },
          "bookDate": {
            "pattern": "\\d{4}-\\d{2}-\\d{2}",
            "type": "string"
          },
          "slot": {
            "type": "string"
          },
          "contact": {
            "pattern": "^1[3-9]\\d{9}$",
            "type": "string"
          },
          "remark": {
            "maxLength": 255,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "BookingCreateResponse": {
        "type": "object",
        "properties": {
          "bookingId": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "duplicated": {
            "type": "boolean"
          }
        }
      },
      "ResultBookingCreateResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "msg": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/BookingCreateResponse"
          }
        }
      },
      "ResultVoid": {
