# .gitignore 模板
# 每个项目复制后，按需调整

# ===== 运行数据 =====
.env
.env.local
.env.*.local
# 运行时数据目录写显式相对路径（#102）：不要用裸 `data/` 通配，
# 否则会把测试夹具目录 qa-automation/data/ 一并排除，CI clone 后用例 collect 缺文件。
runtime/data/
runtime/*.db
*.log
logs/

# ===== 依赖 =====
node_modules/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
.venv/

# ===== 构建产物 =====
dist/
build/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
allure-report/
allure-results/

# ===== IDE / 编辑器 =====
.vscode/
.idea/
*.swp
*.swo
*~

# ===== 操作系统 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 数据库数据 =====
*.db
*.sqlite
*.sqlite3

# ===== 测试夹具例外（#102）=====
# qa-automation/data/ 下的边界/反向夹具（如 test_accounts.yaml）是用例引用的入参，必须入库；
# 若运行时数据规则后来改成了 `data/` 通配，用下面这条取反把夹具目录放回。
# !**/qa-automation/data/

# ===== Docker 数据 =====
# （如果用 docker-compose，数据卷不在项目目录里，不需要忽略）

# ===== 临时文件 =====
*.tmp
*.bak
.cache/
