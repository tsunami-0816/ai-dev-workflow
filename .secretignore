# ============================================================
# .secretignore — 密钥扫描豁免清单（仅测试夹具/示例，不豁免真实密钥）
#
# 用法：每行一个「相对仓库根目录」的精确路径或 fnmatch glob；
#       整行以 # 开头、或行尾 # 之后为注释。
#       命中文件由 scripts/security_scan_secrets.py 打印
#       「⏭️ 忽略（.secretignore）」并计入总结 ignored 计数，不阻塞退出码。
#
# 口径：只有「测试账号/示例占位」且文件本身不是生产代码时才可以列入；
#       真实密钥一律不许靠这里绕过 —— 必须移入 .env、加进 .gitignore、重置密钥。
#
# 背景：CI 干净检出（git archive HEAD）跑
#       `python scripts/security_scan_secrets.py .` 时，下面 9 个
#       冒烟/联调/安全探针/验收/回归脚本与用例夹具命中 Password 模式误报。
# ============================================================

# ---------- 生产异常答疑AI助手：冒烟 / 联调 / 安全探针 / 验收脚本 ----------
# 均为本地 test 账号密码（admin123 / employee123 / wrong-pwd 等），非真实密钥
projects/生产异常答疑AI助手/06_冒烟/scripts/verify_fallback.py  # 冒烟脚本：本地测试账号 employee123
projects/生产异常答疑AI助手/06_冒烟/scripts/verify_fixes.py  # 冒烟脚本：本地测试账号 admin/employee
projects/生产异常答疑AI助手/07_联调/scripts/e2e_full_chain.py  # 联调 e2e：wrong-pwd 是故意错的测试输入
projects/生产异常答疑AI助手/08.5_安全扫描/scripts/security_probe_traversal.py  # 越权探测脚本：测试账号 admin
projects/生产异常答疑AI助手/08_测试/cases/p0_cases.json  # P0 回归用例夹具：登录用的测试账号
projects/生产异常答疑AI助手/08_测试/scripts/verify_sources_fix.py  # 测试校验脚本：测试账号 employee
projects/生产异常答疑AI助手/09_验收/scripts/repro_retrieval_drift.py  # 复现脚本：测试账号 employee/admin
projects/生产异常答疑AI助手/09_验收/scripts/verify_m7_recall.py  # 验收校验脚本：测试账号 employee

# ---------- 工作流仓库自身 ----------
scripts/p0_regression_test.py  # docstring 里 p0_cases.json 的示例 body，admin123 是示例值
